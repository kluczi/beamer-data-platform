#!/bin/sh
# Start the development stack with Apple's `container` CLI (macOS 26+).
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ENV_FILE="$ROOT/.env"
NETWORK=beamer
DNS_DOMAIN=${CONTAINER_DNS_DOMAIN:-beamer}
POSTGRES_CONTAINER="beamer-postgres.${DNS_DOMAIN}"
MINIO_CONTAINER="beamer-minio.${DNS_DOMAIN}"
CLICKHOUSE_CONTAINER="beamer-clickhouse.${DNS_DOMAIN}"
CH_UI_CONTAINER="beamer-ch-ui.${DNS_DOMAIN}"
DUCKDB_CONTAINER="beamer-duckdb.${DNS_DOMAIN}"
SCRAPER_CONTAINER="beamer-scraper.${DNS_DOMAIN}"

require() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Missing required command: $1" >&2
        exit 1
    }
}

remove_container() {
    container delete --force "$1" >/dev/null 2>&1 || true
}

wait_for() {
    name=$1
    shift
    attempt=1
    while ! "$@" >/dev/null 2>&1; do
        if [ "$attempt" -ge 30 ]; then
            echo "$name did not become ready; inspect it with: container logs $name" >&2
            exit 1
        fi
        sleep 2
        attempt=$((attempt + 1))
    done
}

container_ip() {
    container inspect "$1" | sed -n 's/.*"ipv4Address" : "\([0-9.]*\)\\\/.*$/\1/p' | head -n 1
}

require container
[ -f "$ENV_FILE" ] || { echo "Missing $ENV_FILE" >&2; exit 1; }

# shellcheck disable=SC1090
set -a
. "$ENV_FILE"
set +a

: "${POSTGRES_USER:?POSTGRES_USER must be set in .env}"
: "${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set in .env}"
: "${POSTGRES_DB:?POSTGRES_DB must be set in .env}"
: "${MINIO_ROOT_USER:?MINIO_ROOT_USER must be set in .env}"
: "${MINIO_ROOT_PASSWORD:?MINIO_ROOT_PASSWORD must be set in .env}"
: "${MINIO_BUCKET:?MINIO_BUCKET must be set in .env}"
: "${CLICKHOUSE_USER:?CLICKHOUSE_USER must be set in .env}"
: "${CLICKHOUSE_PASSWORD:?CLICKHOUSE_PASSWORD must be set in .env}"
CLICKHOUSE_DB=${CLICKHOUSE_DB:-beamer_warehouse}

container system start
if ! container network list --quiet | grep -Fx "$NETWORK" >/dev/null 2>&1; then
    container network create "$NETWORK"
fi

remove_container beamer-scraper
remove_container beamer-duckdb
remove_container beamer-ch-ui
remove_container beamer-clickhouse
remove_container beamer-minio
remove_container beamer-postgres
remove_container "$SCRAPER_CONTAINER"
remove_container "$DUCKDB_CONTAINER"
remove_container "$CH_UI_CONTAINER"
remove_container "$CLICKHOUSE_CONTAINER"
remove_container "$MINIO_CONTAINER"
remove_container "$POSTGRES_CONTAINER"

container run --detach --init --name "$POSTGRES_CONTAINER" --network "$NETWORK" --dns-domain "$DNS_DOMAIN" \
    --env-file "$ENV_FILE" --env "PGDATA=/var/lib/postgresql/data/pgdata" \
    --publish 127.0.0.1:5432:5432 \
    --volume beamer-postgres-data:/var/lib/postgresql/data \
    docker.io/library/postgres:16
wait_for "$POSTGRES_CONTAINER" container exec "$POSTGRES_CONTAINER" pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"
POSTGRES_IP=$(container_ip "$POSTGRES_CONTAINER")
[ -n "$POSTGRES_IP" ] || { echo "Could not determine PostgreSQL container IP" >&2; exit 1; }

container run --detach --init --name "$MINIO_CONTAINER" --network "$NETWORK" --dns-domain "$DNS_DOMAIN" \
    --env-file "$ENV_FILE" --publish 127.0.0.1:9000:9000 --publish 127.0.0.1:9001:9001 \
    --volume beamer-minio-data:/data \
    docker.io/minio/minio:latest server /data --console-address :9001
MINIO_IP=$(container_ip "$MINIO_CONTAINER")
[ -n "$MINIO_IP" ] || { echo "Could not determine MinIO container IP" >&2; exit 1; }

container run --rm --network "$NETWORK" --dns-domain "$DNS_DOMAIN" --entrypoint /bin/sh --env-file "$ENV_FILE" \
    --env "MINIO_ENDPOINT=http://${MINIO_IP}:9000" \
    docker.io/minio/mc:latest -ec '
        mc alias set local "$MINIO_ENDPOINT" "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD"
        until mc ready local >/dev/null 2>&1; do sleep 1; done
        mc mb -p "local/$MINIO_BUCKET" || true
    '

container run --detach --init --memory 2GiB --name "$CLICKHOUSE_CONTAINER" --network "$NETWORK" --dns-domain "$DNS_DOMAIN" \
    --env-file "$ENV_FILE" --env "CLICKHOUSE_DB=$CLICKHOUSE_DB" \
    --publish 127.0.0.1:8123:8123 --publish 127.0.0.1:9002:9000 \
    --volume beamer-clickhouse-data:/var/lib/clickhouse \
    docker.io/clickhouse/clickhouse-server:latest
wait_for "$CLICKHOUSE_CONTAINER" container exec "$CLICKHOUSE_CONTAINER" clickhouse-client \
    --user "$CLICKHOUSE_USER" --password "$CLICKHOUSE_PASSWORD" --query "SELECT 1"
CLICKHOUSE_IP=$(container_ip "$CLICKHOUSE_CONTAINER")
[ -n "$CLICKHOUSE_IP" ] || { echo "Could not determine ClickHouse container IP" >&2; exit 1; }

container run --detach --init --user 0 --name "$CH_UI_CONTAINER" --network "$NETWORK" --dns-domain "$DNS_DOMAIN" \
    --env "CLICKHOUSE_URL=http://${CLICKHOUSE_IP}:8123" \
    --env "CONNECTION_NAME=Beamer ClickHouse" \
    --publish 127.0.0.1:3488:3488 \
    --volume beamer-ch-ui-data:/app/data \
    ghcr.io/caioricciuti/ch-ui:latest

container run --detach --init --name "$DUCKDB_CONTAINER" --network "$NETWORK" --dns-domain "$DNS_DOMAIN" --env-file "$ENV_FILE" \
    --env "POSTGRES_HOST=$POSTGRES_IP" \
    --env "MINIO_ENDPOINT=${MINIO_IP}:9000" \
    --volume "$ROOT/scripts:/app/scripts" --workdir /app \
    docker.io/library/python:3.12-slim sleep infinity

container build --tag beamer-scraper:local --file "$ROOT/services/scraper/Dockerfile" "$ROOT/services/scraper"
container run --detach --init --name "$SCRAPER_CONTAINER" --network "$NETWORK" --dns-domain "$DNS_DOMAIN" --env-file "$ENV_FILE" \
    --env "POSTGRES_HOST=$POSTGRES_IP" \
    --env "MINIO_ENDPOINT=${MINIO_IP}:9000" \
    --env "CLICKHOUSE_HOST=$CLICKHOUSE_IP" \
    --volume "$ROOT/services/scraper/src:/app/src" \
    beamer-scraper:local python -m src.main

echo "Stack is running. CH-UI is available at: http://localhost:3488"
echo "Follow the pipeline with: container logs --follow $SCRAPER_CONTAINER"
