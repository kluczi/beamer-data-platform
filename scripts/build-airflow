#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BUILD_CONTEXT=$(mktemp -d "$ROOT/.airflow-build.XXXXXX")

cleanup() {
    rm -rf "$BUILD_CONTEXT"
}

trap cleanup EXIT HUP INT TERM

mkdir -p "$BUILD_CONTEXT/orchestration/airflow"
mkdir -p "$BUILD_CONTEXT/dbt/reports/sources"
mkdir -p "$BUILD_CONTEXT/services/scraper"
mkdir -p "$BUILD_CONTEXT/services/dbt"
mkdir -p "$BUILD_CONTEXT/services/evidence"

cp "$ROOT/orchestration/airflow/Dockerfile" "$BUILD_CONTEXT/orchestration/airflow/Dockerfile"
cp "$ROOT/services/scraper/pyproject.toml" "$BUILD_CONTEXT/services/scraper/pyproject.toml"
cp -R "$ROOT/services/scraper/src" "$BUILD_CONTEXT/services/scraper/src"
cp -R "$ROOT/services/dbt/src" "$BUILD_CONTEXT/services/dbt/src"
cp -R "$ROOT/services/evidence/src" "$BUILD_CONTEXT/services/evidence/src"
cp -R "$ROOT/dbt/models" "$BUILD_CONTEXT/dbt/models"
cp "$ROOT/dbt/dbt_project.yml" "$BUILD_CONTEXT/dbt/dbt_project.yml"
cp "$ROOT/dbt/profiles.yml" "$BUILD_CONTEXT/dbt/profiles.yml"
cp "$ROOT/dbt/reports/package.json" "$BUILD_CONTEXT/dbt/reports/package.json"
cp "$ROOT/dbt/reports/package-lock.json" "$BUILD_CONTEXT/dbt/reports/package-lock.json"
cp "$ROOT/dbt/reports/.npmrc" "$BUILD_CONTEXT/dbt/reports/.npmrc"
cp "$ROOT/dbt/reports/evidence.config.yaml" "$BUILD_CONTEXT/dbt/reports/evidence.config.yaml"
cp -R "$ROOT/dbt/reports/pages" "$BUILD_CONTEXT/dbt/reports/pages"
cp -R "$ROOT/dbt/reports/scripts" "$BUILD_CONTEXT/dbt/reports/scripts"
cp -R "$ROOT/dbt/reports/sources/beamer_clickhouse" "$BUILD_CONTEXT/dbt/reports/sources/beamer_clickhouse"

container build --progress plain --tag beamer-airflow:local --file "$BUILD_CONTEXT/orchestration/airflow/Dockerfile" "$BUILD_CONTEXT"
